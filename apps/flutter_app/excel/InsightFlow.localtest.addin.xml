<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  LOCAL WINDOWS TEST COPY. Replace the placeholder Id with the owner-assigned
  stable GUID before sideloading. Use the same Id in InsightFlow.addin.xml.
  This file points the task pane to localhost; do not use it for distribution.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>00000000-0000-0000-0000-000000000001</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>InsightFlow</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="InsightFlow" />
  <Description DefaultValue="InsightFlow data analysis and secure Excel workspace." />
  <IconUrl DefaultValue="https://pritishmete.github.io/data_analysis/icons/Icon-192.png" />
  <HighResolutionIconUrl DefaultValue="https://pritishmete.github.io/data_analysis/icons/Icon-512.png" />
  <SupportUrl DefaultValue="https://pritishmete.github.io/data_analysis/" />
  <AppDomains>
    <AppDomain>https://pritishmete.github.io</AppDomain>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="ExcelApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
