<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Replace the placeholder Id with the stable GUID assigned to this add-in
  before Microsoft 365 deployment. Do not reuse this placeholder in production.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>00000000-0000-0000-0000-000000000001</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>InsightFlow</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="InsightFlow" />
  <Description DefaultValue="InsightFlow data analysis and secure Excel workspace." />
  <IconUrl DefaultValue="https://insightflow-3e8.pages.dev/icons/Icon-192.png" />
  <HighResolutionIconUrl DefaultValue="https://insightflow-3e8.pages.dev/icons/Icon-512.png" />
  <SupportUrl DefaultValue="https://insightflow-3e8.pages.dev/" />
  <AppDomains>
    <AppDomain>https://insightflow-3e8.pages.dev</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="ExcelApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://insightflow-3e8.pages.dev/" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
