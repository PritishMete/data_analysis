[Unit]
Description=InsightFlow FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=insightflow
Group=insightflow
WorkingDirectory=/opt/data_analysis
EnvironmentFile=/etc/insightflow/insightflow.env
ExecStart=/opt/data_analysis/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/insightflow

[Install]
WantedBy=multi-user.target
