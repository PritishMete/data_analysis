# InsightFlow privacy boundary.
# strict (default): workbook headers and cell values are not sent to external AI.
# standard/off: legacy AI behavior; use only when the operator accepts provider access.

# Privacy boundary: local_only is the safe default. Set remote_allowed only when remote dataset processing is intentionally enabled.
INSIGHTFLOW_PRIVACY_MODE=local_only

# Gateway hardening. Render production sets INSIGHTFLOW_ENV=production and
# requires DATABASE_URL; local tests may use an explicit SQLite DATABASE_URL.
INSIGHTFLOW_ENV=development
INSIGHTFLOW_MAX_REQUEST_BYTES=104857600
INSIGHTFLOW_RATE_AUTH_PER_MINUTE=30
INSIGHTFLOW_RATE_UPLOADS_PER_MINUTE=20
INSIGHTFLOW_RATE_EXPENSIVE_PER_MINUTE=60
INSIGHTFLOW_RATE_MANAGEMENT_PER_MINUTE=120
# Keep false in production unless documentation access is intentionally approved.
INSIGHTFLOW_ENABLE_OPENAPI=false
# HSTS is disabled by default. Set true only after confirming the production host
# and every included subdomain are HTTPS-only and HTTP redirects to HTTPS.
INSIGHTFLOW_HSTS_ENABLED=false
# Comma-separated development origins only; production is restricted to the
# verified GitHub Pages origin unless an explicit HTTPS origin is configured.
INSIGHTFLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Managed organization dataset storage (trusted backend only).
# PostgreSQL is authoritative; original CSV archival is optional Supabase Storage.
# Optional managed dataset object size limit in bytes (default 100 MiB).
INSIGHTFLOW_DATASET_MAX_BYTES=104857600

# Managed datasets: PostgreSQL is authoritative; original CSV archive is optional.
INSIGHTFLOW_DATASET_ARCHIVE_ORIGINAL=false
INSIGHTFLOW_DATASET_STORAGE_BUCKET=managed-datasets
# Required only when INSIGHTFLOW_DATASET_ARCHIVE_ORIGINAL=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Profile PII protection. Generate a unique 32-byte random key and store it only
# in the trusted backend secret store (Render environment), never in Git.
# Required to encrypt/decrypt phone and government ID values and migrate legacy rows.
INSIGHTFLOW_PROFILE_PII_KEY=

# Employee invitation email delivery (trusted backend only).
# Never expose this key to Flutter Web.
SUPABASE_SECRET_KEY=
INSIGHTFLOW_EMPLOYEE_INVITE_REDIRECT=https://pritishmete.github.io/data_analysis/employee-invite
