# InsightFlow privacy boundary.
# strict (default): workbook headers and cell values are not sent to external AI.
# standard/off: legacy AI behavior; use only when the operator accepts provider access.

# Privacy boundary: local_only is the safe default. Set remote_allowed only when remote dataset processing is intentionally enabled.
INSIGHTFLOW_PRIVACY_MODE=local_only

# Managed organization dataset storage (trusted backend only).
# PostgreSQL is authoritative; original CSV archival is optional Supabase Storage.
# Optional managed dataset object size limit in bytes (default 100 MiB).
INSIGHTFLOW_DATASET_MAX_BYTES=104857600

# Managed datasets: PostgreSQL is authoritative; original CSV archive is optional.
INSIGHTFLOW_DATASET_ARCHIVE_ORIGINAL=false
INSIGHTFLOW_DATASET_STORAGE_BUCKET=managed-datasets
# Required only when INSIGHTFLOW_DATASET_ARCHIVE_ORIGINAL=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Employee invitation email delivery (trusted backend only).
# Never expose this key to Flutter Web.
SUPABASE_SECRET_KEY=
INSIGHTFLOW_EMPLOYEE_INVITE_REDIRECT=https://pritishmete.github.io/data_analysis/employee-invite

# Application-token invitation delivery adapter (trusted backend only).
# Configure this only after wiring the EXISTING production sender to the callable
# interface in firebase_authz/invitation_email_sender.py. No provider fallback is used.
# Format: INSIGHTFLOW_INVITATION_EMAIL_SENDER=your_package.your_module:send_invitation
INSIGHTFLOW_INVITATION_EMAIL_SENDER=
